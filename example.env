# JWT
JWT_SECRET_KEY=replace_with_a_secure_random_string_here

# Database DSNs
AUTH_DB_DSN=postgres://admin:admin@postgres:5432/admin?sslmode=disable
GAME_DB_DSN=postgres://admin:admin@postgres:5432/game_db?sslmode=disable

# Internal service URLs
GAME_SERVICE_URL=http://gameservice:8001

# Equipment dev helpers
# Keep these false outside local development/testing.
EQUIPMENT_DEV_GRANT_ENABLED=false
# One Uncommon category roll per eligible monster kill. Empty uses 10%.
EQUIPMENT_DROP_CHANCE_OVERRIDE=10
# One ordinary artifact category per barrel; 0..30, empty/invalid uses 4%.
# Quest artifact guarantee is separate and unchanged.
BARREL_ARTIFACT_CHANCE_PERCENT=4

# Frontend origin for auth CORS / local LAN access
# Укажи localhost и свой LAN IP ноутбука
FRONTEND_ORIGIN=http://localhost,http://127.0.0.1,http://192.168.178.31

# Frontend public envs
# Пусто = same-origin
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_AUTH_BASE=
NEXT_PUBLIC_MATCHMAKING_BASE=
NEXT_PUBLIC_EQUIPMENT_DEV_GRANT_ENABLED=false

# Independent Compose copies use a different project name, ports and env file.
NACHALO_ENV_FILE=.env
NACHALO_HTTP_PORT=80
NACHALO_ADMINER_PORT=8080

# Existing ruleset for new matches; formulas remain in the server code.
NACHALO_COMBAT_RULESET=experimental_v34
